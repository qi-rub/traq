proc TreeGen(xs : Arr<10, Fin<2>>, pr : Fin<1000>, ok : Fin<2>, xs' : Arr<10, Fin<2>>) { locals : (zero_wt : Fin<1000>, zero_pr : Fin<1000>, wt' : Fin<1000>, pr' : Fin<1000>, iter_2 : Fin<10>) } {
  zero_wt := 0:Fin<1000>;
  zero_pr := 0:Fin<1000>;
  xs' := xs;
  wt' := zero_wt;
  pr' := zero_pr;
  for (#ITER_5 in 0 .. < 10) {
    iter_2 := #ITER_5;
    call TreeGenLoopBody(xs', wt', pr', iter_2, xs', wt', pr');
  }
  ok := (pr < pr');
}

