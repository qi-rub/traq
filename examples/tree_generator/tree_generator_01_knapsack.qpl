proc TotalProfit(xs : Arr<10, Fin<2>>, pr : Fin<1000>) { locals : (zero : Fin<1000>, i : Fin<10>, xi : Fin<2>, pi : Fin<1000>, i : Fin<10>) } {
  zero := 0:Fin<1000>;
  pr := 0:Fin<1000>;
  for (#ITER_1 in 0 .. < 10) {
    i := #ITER_1;
    xi := xs[i];
    call Profit(i, pi);
    pi := (ifte xi pi zero);
    pr := (pr + pi);
  }
}

uproc TreeGenLoopBody_U(xs : IN Arr<10, Fin<2>>, wt : IN Fin<1000>, pr : IN Fin<1000>, i : IN Fin<10>, xs' : OUT Arr<10, Fin<2>>, new_wt : OUT Fin<1000>, new_pr : OUT Fin<1000>, xi : AUX Fin<2>, y : AUX Fin<2>, try_pick : AUX Fin<2>, wi : AUX Fin<1000>, wt_picked : AUX Fin<1000>, c : AUX Fin<1000>, can_fit : AUX Fin<2>, should_pick : AUX Fin<2>, pi : AUX Fin<1000>, pr_picked : AUX Fin<1000>, xi_21 : AUX Fin<2>, y_1 : AUX Fin<2>, y_1_1 : AUX Fin<2>, try_pick_1 : AUX Fin<2>, wi_21 : AUX Fin<1000>, wt_picked_1 : AUX Fin<1000>, c_1 : AUX Fin<1000>, can_fit_1 : AUX Fin<2>, should_pick_1 : AUX Fin<2>, xs'_1 : AUX Arr<10, Fin<2>>, new_wt_1 : AUX Fin<1000>, pi_21 : AUX Fin<1000>, pr_picked_1 : AUX Fin<1000>, new_pr_1 : AUX Fin<1000>) {
  i, xs, xi_21 *= Embed[(i, xs) => xs[i]];
  xi, xi_21 *= SWAP;
  y_1 *= Distr[bernoulli[0.2]];
  y_1, y_1_1 *= COPY;
  y, y_1 *= SWAP;
  xi, y, try_pick_1 *= Embed[(xi, y) => (xi ^ y)];
  try_pick, try_pick_1 *= SWAP;
  call Weight_U(i, wi_21);
  wi, wi_21 *= SWAP;
  wi, wt, wt_picked_1 *= Embed[(wi, wt) => (wt + wi)];
  wt_picked, wt_picked_1 *= SWAP;
  call Capacity_U(c_1);
  c, c_1 *= SWAP;
  c, wt_picked, can_fit_1 *= Embed[(c, wt_picked) => (wt_picked <= c)];
  can_fit, can_fit_1 *= SWAP;
  can_fit, try_pick, should_pick_1 *= Embed[(can_fit, try_pick) => (try_pick && can_fit)];
  should_pick, should_pick_1 *= SWAP;
  i, should_pick, xs, xs'_1 *= Embed[(i, should_pick, xs) => update xs[i] = should_pick];
  xs', xs'_1 *= SWAP;
  should_pick, wt, wt_picked, new_wt_1 *= Embed[(should_pick, wt, wt_picked) => (ifte should_pick wt_picked wt)];
  new_wt, new_wt_1 *= SWAP;
  call Profit_U(i, pi_21);
  pi, pi_21 *= SWAP;
  pi, pr, pr_picked_1 *= Embed[(pi, pr) => (pr + pi)];
  pr_picked, pr_picked_1 *= SWAP;
  pr, pr_picked, should_pick, new_pr_1 *= Embed[(pr, pr_picked, should_pick) => (ifte should_pick pr_picked pr)];
  new_pr, new_pr_1 *= SWAP;
}

proc TreeGenLoopBody(xs : Arr<10, Fin<2>>, wt : Fin<1000>, pr : Fin<1000>, i : Fin<10>, xs' : Arr<10, Fin<2>>, new_wt : Fin<1000>, new_pr : Fin<1000>) { locals : (xi : Fin<2>, y : Fin<2>, try_pick : Fin<2>, wi : Fin<1000>, wt_picked : Fin<1000>, c : Fin<1000>, can_fit : Fin<2>, should_pick : Fin<2>, pi : Fin<1000>, pr_picked : Fin<1000>) } {
  xi := xs[i];
  y :=$ bernoulli[0.2];
  try_pick := (xi ^ y);
  call Weight(i, wi);
  wt_picked := (wt + wi);
  call Capacity(c);
  can_fit := (wt_picked <= c);
  should_pick := (try_pick && can_fit);
  xs' := update xs[i] = should_pick;
  new_wt := (ifte should_pick wt_picked wt);
  call Profit(i, pi);
  pr_picked := (pr + pi);
  new_pr := (ifte should_pick pr_picked pr);
}

uproc TreeGen_U(xs : IN Arr<10, Fin<2>>, pr : IN Fin<1000>, ok : OUT Fin<2>, xs' : OUT Arr<10, Fin<2>>, zero_wt : AUX Fin<1000>, zero_pr : AUX Fin<1000>, wt' : AUX Fin<1000>, pr' : AUX Fin<1000>, zero_wt_1 : AUX Fin<1000>, zero_pr_1 : AUX Fin<1000>, xs'_2 : AUX Arr<10, Fin<2>>, wt'_1 : AUX Fin<1000>, pr'_1 : AUX Fin<1000>, aux : AUX Arr<10, Fin<2>>, aux_1 : AUX Arr<10, Fin<2>>, aux_2 : AUX Arr<10, Fin<2>>, aux_3 : AUX Arr<10, Fin<1000>>, aux_4 : AUX Arr<10, Fin<1000>>, aux_5 : AUX Arr<10, Fin<1000>>, aux_6 : AUX Arr<10, Fin<2>>, aux_7 : AUX Arr<10, Fin<2>>, aux_8 : AUX Arr<10, Fin<1000>>, aux_9 : AUX Arr<10, Fin<1000>>, aux_10 : AUX Arr<10, Fin<2>>, aux_11 : AUX Arr<10, Fin<2>>, aux_12 : AUX Arr<10, Fin<2>>, aux_13 : AUX Arr<10, Fin<2>>, aux_14 : AUX Arr<10, Fin<1000>>, aux_15 : AUX Arr<10, Fin<1000>>, aux_16 : AUX Arr<10, Fin<1000>>, aux_17 : AUX Arr<10, Fin<2>>, aux_18 : AUX Arr<10, Fin<2>>, aux_19 : AUX Arr<10, Arr<10, Fin<2>>>, aux_20 : AUX Arr<10, Fin<1000>>, aux_21 : AUX Arr<10, Fin<1000>>, aux_22 : AUX Arr<10, Fin<1000>>, aux_23 : AUX Arr<10, Fin<1000>>, aux_24 : AUX Arr<10, Fin<10>>, aux_25 : AUX Arr<11, Arr<10, Fin<2>>>, aux_26 : AUX Arr<11, Fin<1000>>, aux_27 : AUX Arr<11, Fin<1000>>, ok_1 : AUX Fin<2>) {
  zero_wt_1 *= Embed[() => 0:Fin<1000>];
  zero_wt, zero_wt_1 *= SWAP;
  zero_pr_1 *= Embed[() => 0:Fin<1000>];
  zero_pr, zero_pr_1 *= SWAP;
  xs, aux_25[0] *= COPY;
  zero_wt, aux_26[0] *= COPY;
  zero_pr, aux_27[0] *= COPY;
  for (#ITER_2 in 0 .. < 10) {
    call TreeGenLoopBody_U(aux_25[#ITER_2], aux_26[#ITER_2], aux_27[#ITER_2], aux_24[#ITER_2], aux_25[#ITER_2], aux_26[#ITER_2], aux_27[#ITER_2], aux[#ITER_2], aux_1[#ITER_2], aux_2[#ITER_2], aux_3[#ITER_2], aux_4[#ITER_2], aux_5[#ITER_2], aux_6[#ITER_2], aux_7[#ITER_2], aux_8[#ITER_2], aux_9[#ITER_2], aux_10[#ITER_2], aux_11[#ITER_2], aux_12[#ITER_2], aux_13[#ITER_2], aux_14[#ITER_2], aux_15[#ITER_2], aux_16[#ITER_2], aux_17[#ITER_2], aux_18[#ITER_2], aux_19[#ITER_2], aux_20[#ITER_2], aux_21[#ITER_2], aux_22[#ITER_2], aux_23[#ITER_2]);
  }
  aux_25[10], xs'_2 *= COPY;
  aux_26[10], wt'_1 *= COPY;
  aux_27[10], pr'_1 *= COPY;
  xs', wt', pr', xs'_2, wt'_1, pr'_1 *= SWAP;
  pr, pr', ok_1 *= Embed[(pr, pr') => (pr < pr')];
  ok, ok_1 *= SWAP;
}

proc TreeGen(xs : Arr<10, Fin<2>>, pr : Fin<1000>, ok : Fin<2>, xs' : Arr<10, Fin<2>>) { locals : (zero_wt : Fin<1000>, zero_pr : Fin<1000>, wt' : Fin<1000>, pr' : Fin<1000>, iter : Fin<10>) } {
  zero_wt := 0:Fin<1000>;
  zero_pr := 0:Fin<1000>;
  xs' := xs;
  wt' := zero_wt;
  pr' := zero_pr;
  for (#ITER_3 in 0 .. < 10) {
    iter := #ITER_3;
    call TreeGenLoopBody(xs', wt', pr', iter, xs', wt', pr');
  }
  ok := (pr < pr');
}

