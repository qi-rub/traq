uproc AddWeight_U(xs : IN Arr<10, Fin<2>>, cur_wt : IN Fin<1000>, i : IN Fin<10>, xs' : OUT Arr<10, Fin<2>>, new_wt : OUT Fin<1000>, xi : AUX Fin<2>, wi : AUX Fin<1000>, zero : AUX Fin<1000>, wi_pick : AUX Fin<1000>, xi_1 : AUX Fin<2>, wi_1 : AUX Fin<1000>, zero_1 : AUX Fin<1000>, wi_pick_1 : AUX Fin<1000>, new_wt_1 : AUX Fin<1000>, xs'_1 : AUX Arr<10, Fin<2>>) {
  i, xs, xi_1 *= Embed[(i, xs) => xs[i]];
  xi, xi_1 *= SWAP;
  call Weight_U(i, wi_1);
  wi, wi_1 *= SWAP;
  zero_1 *= Embed[() => 0:Fin<1000>];
  zero, zero_1 *= SWAP;
  wi, xi, zero, wi_pick_1 *= Embed[(wi, xi, zero) => (ifte xi wi zero)];
  wi_pick, wi_pick_1 *= SWAP;
  cur_wt, wi_pick, new_wt_1 *= Embed[(cur_wt, wi_pick) => (cur_wt + wi_pick)];
  new_wt, new_wt_1 *= SWAP;
  xs, xs'_1 *= Embed[(xs) => xs];
  xs', xs'_1 *= SWAP;
}

proc AddWeight(xs : Arr<10, Fin<2>>, cur_wt : Fin<1000>, i : Fin<10>, xs' : Arr<10, Fin<2>>, new_wt : Fin<1000>) { locals : (xi : Fin<2>, wi : Fin<1000>, zero : Fin<1000>, wi_pick : Fin<1000>) } {
  xi := xs[i];
  call Weight(i, wi);
  zero := 0:Fin<1000>;
  wi_pick := (ifte xi wi zero);
  new_wt := (cur_wt + wi_pick);
  xs' := xs;
}

uproc TotalWeight_U(xs : IN Arr<10, Fin<2>>, wt : OUT Fin<1000>, zero : AUX Fin<1000>, xs' : AUX Arr<10, Fin<2>>, zero_2 : AUX Fin<1000>, xs'_2 : AUX Arr<10, Fin<2>>, wt_1 : AUX Fin<1000>, aux : AUX Arr<10, Fin<2>>, aux_1 : AUX Arr<10, Fin<1000>>, aux_2 : AUX Arr<10, Fin<1000>>, aux_3 : AUX Arr<10, Fin<1000>>, aux_4 : AUX Arr<10, Fin<2>>, aux_5 : AUX Arr<10, Fin<1000>>, aux_6 : AUX Arr<10, Fin<1000>>, aux_7 : AUX Arr<10, Fin<1000>>, aux_8 : AUX Arr<10, Fin<1000>>, aux_9 : AUX Arr<10, Arr<10, Fin<2>>>, aux_10 : AUX Arr<10, Fin<10>>, aux_11 : AUX Arr<11, Arr<10, Fin<2>>>, aux_12 : AUX Arr<11, Fin<1000>>) {
  zero_2 *= Embed[() => 0:Fin<1000>];
  zero, zero_2 *= SWAP;
  xs, aux_11[0] *= COPY;
  zero, aux_12[0] *= COPY;
  for (#ITER in 0 .. < 10) {
    call AddWeight_U(aux_11[#ITER], aux_12[#ITER], aux_10[#ITER], aux_11[#ITER], aux_12[#ITER], aux[#ITER], aux_1[#ITER], aux_2[#ITER], aux_3[#ITER], aux_4[#ITER], aux_5[#ITER], aux_6[#ITER], aux_7[#ITER], aux_8[#ITER], aux_9[#ITER]);
  }
  aux_11[10], xs'_2 *= COPY;
  aux_12[10], wt_1 *= COPY;
  xs', wt, xs'_2, wt_1 *= SWAP;
}

proc TotalWeight(xs : Arr<10, Fin<2>>, wt : Fin<1000>) { locals : (zero : Fin<1000>, xs' : Arr<10, Fin<2>>, iter : Fin<10>) } {
  zero := 0:Fin<1000>;
  xs' := xs;
  wt := zero;
  for (#ITER_1 in 0 .. < 10) {
    iter := #ITER_1;
    call AddWeight(xs', wt, iter, xs', wt);
  }
}

uproc AddProfit_U(xs : IN Arr<10, Fin<2>>, cur_pr : IN Fin<1000>, i : IN Fin<10>, xs' : OUT Arr<10, Fin<2>>, new_pr : OUT Fin<1000>, xi : AUX Fin<2>, pi : AUX Fin<1000>, zero : AUX Fin<1000>, pi_pick : AUX Fin<1000>, xi_2 : AUX Fin<2>, pi_1 : AUX Fin<1000>, zero_3 : AUX Fin<1000>, pi_pick_1 : AUX Fin<1000>, new_pr_1 : AUX Fin<1000>, xs'_3 : AUX Arr<10, Fin<2>>) {
