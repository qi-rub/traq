proc QAmplify(xs : Arr<10, Fin<2>>, pr : Fin<1000>, ret_2 : Fin<2>, ret_3 : Arr<10, Fin<2>>) { locals : (not_done : Fin<2>, Q_sum : Fin<92>, j : Fin<92>, j_lim : Fin<92>) } {
  not_done := 0:Fin<2>;
  repeat (8) {
    Q_sum := 0:Fin<92>;
    for (j_lim in [1:Fin<92>, 1:Fin<92>, 1:Fin<92>, 2:Fin<92>, 2:Fin<92>, 2:Fin<92>, 3:Fin<92>, 4:Fin<92>, 5:Fin<92>, 6:Fin<92>, 7:Fin<92>, 8:Fin<92>, 10:Fin<92>, 10:Fin<92>, 10:Fin<92>, 10:Fin<92>, 10:Fin<92>]) {
      j :=$ [1 .. j_lim];
      Q_sum := (Q_sum + j);
      not_done := (not_done && (Q_sum <= j_lim));
      if (not_done) {
        meas Grover[j](xs, pr, ret_2, ret_3);
        not_done := (not_done && not ret_2);
      } else {
        skip;
      }
    }
  }
}

proc KnapsackLoopBody(xs : Arr<10, Fin<2>>, i : Fin<3>, xs_next : Arr<10, Fin<2>>) { locals : (pr : Fin<1000>, ok : Fin<2>, xs' : Arr<10, Fin<2>>) } {
  call TotalProfit(xs, pr);
  call QAmplify(xs, pr, ok, xs');
  xs_next := (ifte ok xs' xs);
