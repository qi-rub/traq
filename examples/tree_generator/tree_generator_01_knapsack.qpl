uproc TreeGenLoopBody_U(xs : IN Arr<10, Fin<2>>, wt : IN Fin<1000>, pr : IN Fin<1000>, i : IN Fin<10>, xs' : OUT Arr<10, Fin<2>>, new_wt : OUT Fin<1000>, new_pr : OUT Fin<1000>, xi : AUX Fin<2>, y : AUX Fin<2>, try_pick : AUX Fin<2>, wi : AUX Fin<1000>, wt_picked : AUX Fin<1000>, c : AUX Fin<1000>, can_fit : AUX Fin<2>, should_pick : AUX Fin<2>, pi : AUX Fin<1000>, pr_picked : AUX Fin<1000>, xi_3 : AUX Fin<2>, y_1 : AUX Fin<2>, y_1_1 : AUX Fin<2>, try_pick_1 : AUX Fin<2>, wi_2 : AUX Fin<1000>, wt_picked_1 : AUX Fin<1000>, c_1 : AUX Fin<1000>, can_fit_1 : AUX Fin<2>, should_pick_1 : AUX Fin<2>, xs'_5 : AUX Arr<10, Fin<2>>, new_wt_2 : AUX Fin<1000>, pi_2 : AUX Fin<1000>, pr_picked_1 : AUX Fin<1000>, new_pr_2 : AUX Fin<1000>) {
  i, xs, xi_3 *= Embed[(i, xs) => xs[i]];
  xi, xi_3 *= SWAP;
  y_1 *= Distr[bernoulli[0.2]];
  y_1, y_1_1 *= COPY;
  y, y_1 *= SWAP;
  xi, y, try_pick_1 *= Embed[(xi, y) => (xi ^ y)];
  try_pick, try_pick_1 *= SWAP;
  call Weight_U(i, wi_2);
  wi, wi_2 *= SWAP;
  wi, wt, wt_picked_1 *= Embed[(wi, wt) => (wt + wi)];
  wt_picked, wt_picked_1 *= SWAP;
  call Capacity_U(c_1);
  c, c_1 *= SWAP;
  c, wt_picked, can_fit_1 *= Embed[(c, wt_picked) => (wt_picked <= c)];
  can_fit, can_fit_1 *= SWAP;
  can_fit, try_pick, should_pick_1 *= Embed[(can_fit, try_pick) => (try_pick && can_fit)];
  should_pick, should_pick_1 *= SWAP;
  i, should_pick, xs, xs'_5 *= Embed[(i, should_pick, xs) => update xs[i] = should_pick];
  xs', xs'_5 *= SWAP;
  should_pick, wt, wt_picked, new_wt_2 *= Embed[(should_pick, wt, wt_picked) => (ifte should_pick wt_picked wt)];
  new_wt, new_wt_2 *= SWAP;
  call Profit_U(i, pi_2);
  pi, pi_2 *= SWAP;
  pi, pr, pr_picked_1 *= Embed[(pi, pr) => (pr + pi)];
  pr_picked, pr_picked_1 *= SWAP;
  pr, pr_picked, should_pick, new_pr_2 *= Embed[(pr, pr_picked, should_pick) => (ifte should_pick pr_picked pr)];
  new_pr, new_pr_2 *= SWAP;
}

proc TreeGenLoopBody(xs : Arr<10, Fin<2>>, wt : Fin<1000>, pr : Fin<1000>, i : Fin<10>, xs' : Arr<10, Fin<2>>, new_wt : Fin<1000>, new_pr : Fin<1000>) { locals : (xi : Fin<2>, y : Fin<2>, try_pick : Fin<2>, wi : Fin<1000>, wt_picked : Fin<1000>, c : Fin<1000>, can_fit : Fin<2>, should_pick : Fin<2>, pi : Fin<1000>, pr_picked : Fin<1000>) } {
  xi := xs[i];
  y :=$ bernoulli[0.2];
  try_pick := (xi ^ y);
  call Weight(i, wi);
  wt_picked := (wt + wi);
  call Capacity(c);
  can_fit := (wt_picked <= c);
  should_pick := (try_pick && can_fit);
  xs' := update xs[i] = should_pick;
  new_wt := (ifte should_pick wt_picked wt);
  call Profit(i, pi);
  pr_picked := (pr + pi);
  new_pr := (ifte should_pick pr_picked pr);
}

