proc TotalProfit(xs : Arr<10, Fin<2>>, pr : Fin<1000>) { locals : (zero : Fin<1000>, i : Fin<10>, xi : Fin<2>, pi : Fin<1000>, i : Fin<10>) } {
  zero := const 0:Fin<1000>;
  pr := const 0:Fin<1000>;
  for (#ITER_1 in 0 .. < 10) {
    i := #ITER_1;
    xi := xs[i];
    call Profit(i, pi);
    pi := (xi ? pi : zero);
    pr := (pr + pi);
  }
}

