}

proc QAmplify(xs : Arr<4, Fin<2>>, pr : Fin<1000>, ret_6 : Fin<2>, ret_7 : Arr<4, Fin<2>>) { locals : (not_done : Fin<2>, Q_sum : Fin<230>, j : Fin<230>, j_lim : Fin<230>) } {
  not_done := const 0:Fin<2>;
  repeat (8) {
    Q_sum := const 0:Fin<230>;
    for (j_lim in [const 1:Fin<230>, const 1:Fin<230>, const 1:Fin<230>, const 2:Fin<230>, const 2:Fin<230>, const 2:Fin<230>, const 3:Fin<230>, const 4:Fin<230>, const 5:Fin<230>, const 6:Fin<230>, const 7:Fin<230>, const 8:Fin<230>, const 10:Fin<230>, const 12:Fin<230>, const 15:Fin<230>, const 18:Fin<230>, const 22:Fin<230>, const 25:Fin<230>, const 25:Fin<230>, const 25:Fin<230>, const 25:Fin<230>]) {
      j :=$ [1 .. j_lim];
      Q_sum := (Q_sum + j);
      not_done := (not_done && (Q_sum <= j_lim));
      if (not_done) {
        meas Grover[j](xs, pr, ret_6, ret_7);
        not_done := (not_done && not ret_6);
      } else {
        skip;
      }
    }
  }
}

proc Knapsack(xs : Arr<4, Fin<2>>) { locals : (iter : Fin<3>, pr : Fin<1000>, ok : Fin<2>, xs' : Arr<4, Fin<2>>, iter : Fin<3>) } {
  xs := default : Arr<4, Fin<2>>;
  for (#ITER_3 in 0 .. < 3) {
    iter := #ITER_3;
    call TotalProfit(xs, pr);
    call QAmplify(xs, pr, ok, xs');
    xs := (ok ? xs' : xs);
  }
}


