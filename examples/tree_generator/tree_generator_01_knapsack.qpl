proc TotalWeight(xs : Arr<4, Fin<2>>, wt : Fin<1000>) { locals : (zero : Fin<1000>, i : Fin<4>, xi : Fin<2>, wi : Fin<1000>, i : Fin<4>) } {
  zero := const 0:Fin<1000>;
  wt := const 0:Fin<1000>;
  for (#ITER in 0 .. < 4) {
    i := #ITER;
    xi := xs[i];
    call Weight(i, wi);
    wi := (xi ? wi : zero);
    wt := (wt + wi);
  }
}

