  }
  aux_51[10], xs'_6 *= COPY;
  aux_52[10], wt'_1 *= COPY;
  aux_53[10], pr'_1 *= COPY;
  xs', wt', pr', xs'_6, wt'_1, pr'_1 *= SWAP;
