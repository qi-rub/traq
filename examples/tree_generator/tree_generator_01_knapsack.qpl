proc TreeGen(xs : Arr<10, Fin<2>>, old_pr : Fin<1000>, ok : Fin<2>, xs : Arr<10, Fin<2>>) { locals : (wt : Fin<1000>, pr : Fin<1000>, c : Fin<1000>, i : Fin<10>, xi : Fin<2>, y : Fin<2>, try_pick : Fin<2>, wi : Fin<1000>, wt_picked : Fin<1000>, can_fit : Fin<2>, should_pick : Fin<2>, pi : Fin<1000>, i : Fin<10>) } {
  wt := const 0:Fin<1000>;
  pr := const 0:Fin<1000>;
  call Capacity(c);
  for (#ITER_2 in 0 .. < 10) {
    i := #ITER_2;
    xi := xs[i];
    y :=$ bernoulli[0.2];
    try_pick := (xi ^ y);
    call Weight(i, wi);
    wt_picked := (wt + wi);
    can_fit := (wt_picked <= c);
    should_pick := (try_pick && can_fit);
    if (should_pick) {
      xs := update xs[i] = should_pick;
      wt := wt_picked;
      call Profit(i, pi);
      pr := (pr + pi);
    } else {
    }
  }
  ok := (old_pr < pr);
