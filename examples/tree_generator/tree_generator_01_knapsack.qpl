proc TotalProfit(xs : Arr<4, Fin<2>>, pr : Fin<1000>) { locals : (zero : Fin<1000>, i : Fin<4>, xi : Fin<2>, pi : Fin<1000>, i : Fin<4>) } {
  zero := const 0:Fin<1000>;
  pr := const 0:Fin<1000>;
  for (#ITER_1 in 0 .. < 4) {
    i := #ITER_1;
    xi := xs[i];
    call Profit(i, pi);
    pi := (xi ? pi : zero);
    pr := (pr + pi);
  }
}

