proc TotalProfit(xs : Arr<10, Fin<2>>, pr : Fin<1000>) { locals : (zero : Fin<1000>, xs' : Arr<10, Fin<2>>, iter_1 : Fin<10>) } {
  zero := 0:Fin<1000>;
  xs' := xs;
