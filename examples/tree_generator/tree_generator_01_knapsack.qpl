uproc Grover[k](xs : Arr<10, Fin<2>>, pr : Fin<1000>, ret_8 : Fin<2>, ret_9 : Arr<10, Fin<2>>, aux_310 : AUX Fin<1000>, aux_311 : AUX Fin<1000>, aux_312 : AUX Fin<1000>, aux_313 : AUX Fin<1000>, aux_314 : AUX Fin<1000>, aux_315 : AUX Fin<1000>, aux_316 : AUX Arr<10, Fin<2>>, aux_317 : AUX Fin<1000>, aux_318 : AUX Fin<1000>, aux_319 : AUX Arr<10, Fin<2>>, aux_320 : AUX Arr<10, Fin<2>>, aux_321 : AUX Arr<10, Fin<2>>, aux_322 : AUX Arr<10, Fin<1000>>, aux_323 : AUX Arr<10, Fin<1000>>, aux_324 : AUX Arr<10, Fin<1000>>, aux_325 : AUX Arr<10, Fin<2>>, aux_326 : AUX Arr<10, Fin<2>>, aux_327 : AUX Arr<10, Fin<1000>>, aux_328 : AUX Arr<10, Fin<1000>>, aux_329 : AUX Arr<10, Fin<2>>, aux_330 : AUX Arr<10, Fin<2>>, aux_331 : AUX Arr<10, Fin<2>>, aux_332 : AUX Arr<10, Fin<2>>, aux_333 : AUX Arr<10, Fin<1000>>, aux_334 : AUX Arr<10, Fin<1000>>, aux_335 : AUX Arr<10, Fin<1000>>, aux_336 : AUX Arr<10, Fin<2>>, aux_337 : AUX Arr<10, Fin<2>>, aux_338 : AUX Arr<10, Arr<10, Fin<2>>>, aux_339 : AUX Arr<10, Fin<1000>>, aux_340 : AUX Arr<10, Fin<1000>>, aux_341 : AUX Arr<10, Fin<1000>>, aux_342 : AUX Arr<10, Fin<1000>>, aux_343 : AUX Arr<10, Fin<10>>, aux_344 : AUX Arr<11, Arr<10, Fin<2>>>, aux_345 : AUX Arr<11, Fin<1000>>, aux_346 : AUX Arr<11, Fin<1000>>, aux_347 : AUX Fin<2>) {
  call TreeGen_U(xs, pr, ret_8, ret_9, aux_310, aux_311, aux_312, aux_313, aux_314, aux_315, aux_316, aux_317, aux_318, aux_319, aux_320, aux_321, aux_322, aux_323, aux_324, aux_325, aux_326, aux_327, aux_328, aux_329, aux_330, aux_331, aux_332, aux_333, aux_334, aux_335, aux_336, aux_337, aux_338, aux_339, aux_340, aux_341, aux_342, aux_343, aux_344, aux_345, aux_346, aux_347);
  repeat (#k) {
    ret_8 *= Z;
    call-adj TreeGen_U(xs, pr, ret_8, ret_9, aux_310, aux_311, aux_312, aux_313, aux_314, aux_315, aux_316, aux_317, aux_318, aux_319, aux_320, aux_321, aux_322, aux_323, aux_324, aux_325, aux_326, aux_327, aux_328, aux_329, aux_330, aux_331, aux_332, aux_333, aux_334, aux_335, aux_336, aux_337, aux_338, aux_339, aux_340, aux_341, aux_342, aux_343, aux_344, aux_345, aux_346, aux_347);
    ret_8, ret_9, aux_310, aux_311, aux_312, aux_313, aux_314, aux_315, aux_316, aux_317, aux_318, aux_319, aux_320, aux_321, aux_322, aux_323, aux_324, aux_325, aux_326, aux_327, aux_328, aux_329, aux_330, aux_331, aux_332, aux_333, aux_334, aux_335, aux_336, aux_337, aux_338, aux_339, aux_340, aux_341, aux_342, aux_343, aux_344, aux_345, aux_346, aux_347 *= PhaseOnZero(3.141592653589793);
    call TreeGen_U(xs, pr, ret_8, ret_9, aux_310, aux_311, aux_312, aux_313, aux_314, aux_315, aux_316, aux_317, aux_318, aux_319, aux_320, aux_321, aux_322, aux_323, aux_324, aux_325, aux_326, aux_327, aux_328, aux_329, aux_330, aux_331, aux_332, aux_333, aux_334, aux_335, aux_336, aux_337, aux_338, aux_339, aux_340, aux_341, aux_342, aux_343, aux_344, aux_345, aux_346, aux_347);
  }
}

proc QAmplify(xs : Arr<10, Fin<2>>, pr : Fin<1000>, ret_6 : Fin<2>, ret_7 : Arr<10, Fin<2>>) { locals : (not_done : Fin<2>, Q_sum : Fin<92>, j : Fin<92>, j_lim : Fin<92>) } {
  not_done := 0:Fin<2>;
  repeat (8) {
    Q_sum := 0:Fin<92>;
    for (j_lim in [1:Fin<92>, 1:Fin<92>, 1:Fin<92>, 2:Fin<92>, 2:Fin<92>, 2:Fin<92>, 3:Fin<92>, 4:Fin<92>, 5:Fin<92>, 6:Fin<92>, 7:Fin<92>, 8:Fin<92>, 10:Fin<92>, 10:Fin<92>, 10:Fin<92>, 10:Fin<92>, 10:Fin<92>]) {
      j :=$ [1 .. j_lim];
      Q_sum := (Q_sum + j);
      not_done := (not_done && (Q_sum <= j_lim));
      if (not_done) {
        meas Grover[j](xs, pr, ret_6, ret_7);
        not_done := (not_done && not ret_6);
      } else {
        skip;
      }
    }
  }
}

proc Knapsack(xs : Arr<10, Fin<2>>) { locals : (iter : Fin<3>, pr : Fin<1000>, ok : Fin<2>, xs' : Arr<10, Fin<2>>, iter : Fin<3>) } {
  xs := default : Arr<10, Fin<2>>;
  for (#ITER_4 in 0 .. < 3) {
    iter := #ITER_4;
    call TotalProfit(xs, pr);
    call QAmplify(xs, pr, ok, xs');
    xs := (ifte ok xs' xs);
  }
}


