ext uproc Phi_U(Arr<20, Fin<2>>, Fin<1000>);

ext proc Phi(Arr<20, Fin<2>>, Fin<1000>);

uproc good_U(x : IN Arr<20, Fin<2>>, i : IN Fin<20>, w' : OUT Fin<1000>, w : AUX Fin<1000>, b : AUX Fin<2>, b' : AUX Fin<2>, x' : AUX Arr<20, Fin<2>>, w_1 : AUX Fin<1000>, b_1 : AUX Fin<2>, b'_1 : AUX Fin<2>, x'_1 : AUX Arr<20, Fin<2>>, w'_1 : AUX Fin<1000>) {
  call Phi_U(x, w_1);
  w, w_1 *= SWAP;
  i, x, b_1 *= Embed[(i, x) => x[i]];
  b, b_1 *= SWAP;
  b, b'_1 *= Embed[(b) => not b];
  b', b'_1 *= SWAP;
  b, i, x, x'_1 *= Embed[(b, i, x) => update x[i] = b];
  x', x'_1 *= SWAP;
  call Phi_U(x', w'_1);
  w', w'_1 *= SWAP;
}

proc good(x : Arr<20, Fin<2>>, i : Fin<20>, w' : Fin<1000>) { locals : (w : Fin<1000>, b : Fin<2>, b' : Fin<2>, x' : Arr<20, Fin<2>>) } {
  call Phi(x, w);
  b := x[i];
  b' := not b;
  x' := update x[i] = b;
  call Phi(x', w');
}

uproc UMax(x : Arr<20, Fin<2>>, ret : Fin<1000>, ret_1 : Fin<20>, inp : AUX Arr<20, Fin<20>>, out : AUX Arr<20, Fin<1000>>, aux : AUX Arr<20, Fin<1000>>, aux_1 : AUX Arr<20, Fin<2>>, aux_2 : AUX Arr<20, Fin<2>>, aux_3 : AUX Arr<20, Arr<20, Fin<2>>>, aux_4 : AUX Arr<20, Fin<1000>>, aux_5 : AUX Arr<20, Fin<2>>, aux_6 : AUX Arr<20, Fin<2>>, aux_7 : AUX Arr<20, Arr<20, Fin<2>>>, aux_8 : AUX Arr<20, Fin<1000>>) {
  for (#x_4 in Fin<20>) {
    call good_U(x, inp[#x_4], out[#x_4], aux[#x_4], aux_1[#x_4], aux_2[#x_4], aux_3[#x_4], aux_4[#x_4], aux_5[#x_4], aux_6[#x_4], aux_7[#x_4], aux_8[#x_4]);
  }
  out, ret *= NamedGate("max");
  out, ret_1 *= NamedGate("argmax");
}

uproc hillclimb_iter_U(x : IN Arr<20, Fin<2>>, x' : OUT Arr<20, Fin<2>>, w : AUX Fin<1000>, i : AUX Fin<20>, b : AUX Fin<2>, b' : AUX Fin<2>, w_2 : AUX Fin<1000>, i_1 : AUX Fin<20>, aux_prim : AUX Arr<20, Fin<20>>, aux_prim_1 : AUX Arr<20, Fin<1000>>, aux_prim_2 : AUX Arr<20, Fin<1000>>, aux_prim_3 : AUX Arr<20, Fin<2>>, aux_prim_4 : AUX Arr<20, Fin<2>>, aux_prim_5 : AUX Arr<20, Arr<20, Fin<2>>>, aux_prim_6 : AUX Arr<20, Fin<1000>>, aux_prim_7 : AUX Arr<20, Fin<2>>, aux_prim_8 : AUX Arr<20, Fin<2>>, aux_prim_9 : AUX Arr<20, Arr<20, Fin<2>>>, aux_prim_10 : AUX Arr<20, Fin<1000>>, b_2 : AUX Fin<2>, b'_2 : AUX Fin<2>, x'_2 : AUX Arr<20, Fin<2>>) {
  call UMax(x, w_2, i_1, aux_prim, aux_prim_1, aux_prim_2, aux_prim_3, aux_prim_4, aux_prim_5, aux_prim_6, aux_prim_7, aux_prim_8, aux_prim_9, aux_prim_10);
  w, i, w_2, i_1 *= SWAP;
  i, x, b_2 *= Embed[(i, x) => x[i]];
  b, b_2 *= SWAP;
  b, b'_2 *= Embed[(b) => not b];
  b', b'_2 *= SWAP;
  b, i, x, x'_2 *= Embed[(b, i, x) => update x[i] = b];
  x', x'_2 *= SWAP;
}

uproc Compare(x : Arr<20, Fin<2>>, y : Fin<1000>, x_5 : Fin<20>, b_3 : Fin<2>, out_1 : AUX Fin<1000>, aux_9 : AUX Fin<1000>, aux_10 : AUX Fin<2>, aux_11 : AUX Fin<2>, aux_12 : AUX Arr<20, Fin<2>>, aux_13 : AUX Fin<1000>, aux_14 : AUX Fin<2>, aux_15 : AUX Fin<2>, aux_16 : AUX Arr<20, Fin<2>>, aux_17 : AUX Fin<1000>) {
  call good_U(x, x_5, out_1, aux_9, aux_10, aux_11, aux_12, aux_13, aux_14, aux_15, aux_16, aux_17);
  y, out_1, b_3 *= Embed[(a, b) => (a < b)];
}

uproc Grover[k](x : Arr<20, Fin<2>>, y_1 : Fin<1000>, x_6 : Fin<20>, b_4 : Fin<2>, aux_18 : AUX Fin<1000>, aux_19 : AUX Fin<1000>, aux_20 : AUX Fin<2>, aux_21 : AUX Fin<2>, aux_22 : AUX Arr<20, Fin<2>>, aux_23 : AUX Fin<1000>, aux_24 : AUX Fin<2>, aux_25 : AUX Fin<2>, aux_26 : AUX Arr<20, Fin<2>>, aux_27 : AUX Fin<1000>) {
  b_4 *= X;
  b_4 *= H;
  x_6 *= Distr[uniform : Fin<20>];
  repeat (#k) {
    call Compare(x, y_1, x_6, b_4, aux_18, aux_19, aux_20, aux_21, aux_22, aux_23, aux_24, aux_25, aux_26, aux_27);
    x_6 *= Adj-Distr[uniform : Fin<20>];
    x_6 *= PhaseOnZero(3.141592653589793);
    x_6 *= Distr[uniform : Fin<20>];
  }
  b_4 *= H;
  b_4 *= X;
}

proc QSearch_infty(x : Arr<20, Fin<2>>, fuel : Fin<750>, y_2 : Fin<1000>, x_7 : Fin<20>) { locals : (j_lim : Fin<750>, j : Fin<750>, not_done : Fin<2>, b_5 : Fin<2>) } {
  not_done := const 1:Fin<2>;
  for (j_lim in [const 1:Fin<750>, const 1:Fin<750>, const 1:Fin<750>, const 2:Fin<750>, const 2:Fin<750>, const 2:Fin<750>, const 3:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>, const 4:Fin<750>]) {
    j :=$ [1 .. j_lim];
    not_done := (not_done && (j <= fuel));
    if (not_done) {
      fuel := (fuel - j);
      meas Grover[j](x, y_2, x_7, b_5);
      not_done := (not_done && not b_5);
    } else {
      skip;
    }
  }
}

proc QMax(x : Arr<20, Fin<2>>, ret_2 : Fin<1000>, ret_3 : Fin<20>) { locals : (fuel_1 : Fin<750>) } {
  fuel_1 := const 749:Fin<750>;
  ret_3 :=$ uniform : Fin<20>;
  call good(x, ret_3, ret_2);
  repeat (750) {
    call QSearch_infty(x, fuel_1, ret_2, ret_3);
  }
}

proc hillclimb_iter(x : Arr<20, Fin<2>>, x' : Arr<20, Fin<2>>) { locals : (w : Fin<1000>, i : Fin<20>, b : Fin<2>, b' : Fin<2>) } {
  call QMax(x, w, i);
  b := x[i];
  b' := not b;
  x' := update x[i] = b;
}

uproc hillclimb_3_U(x_3 : OUT Arr<20, Fin<2>>, x_0 : AUX Arr<20, Fin<2>>, x_1 : AUX Arr<20, Fin<2>>, x_2 : AUX Arr<20, Fin<2>>, x_0_1 : AUX Arr<20, Fin<2>>, x_0_1_1 : AUX Arr<20, Fin<2>>, x_1_1 : AUX Arr<20, Fin<2>>, aux_28 : AUX Fin<1000>, aux_29 : AUX Fin<20>, aux_30 : AUX Fin<2>, aux_31 : AUX Fin<2>, aux_32 : AUX Fin<1000>, aux_33 : AUX Fin<20>, aux_34 : AUX Arr<20, Fin<20>>, aux_35 : AUX Arr<20, Fin<1000>>, aux_36 : AUX Arr<20, Fin<1000>>, aux_37 : AUX Arr<20, Fin<2>>, aux_38 : AUX Arr<20, Fin<2>>, aux_39 : AUX Arr<20, Arr<20, Fin<2>>>, aux_40 : AUX Arr<20, Fin<1000>>, aux_41 : AUX Arr<20, Fin<2>>, aux_42 : AUX Arr<20, Fin<2>>, aux_43 : AUX Arr<20, Arr<20, Fin<2>>>, aux_44 : AUX Arr<20, Fin<1000>>, aux_45 : AUX Fin<2>, aux_46 : AUX Fin<2>, aux_47 : AUX Arr<20, Fin<2>>, x_2_1 : AUX Arr<20, Fin<2>>, aux_48 : AUX Fin<1000>, aux_49 : AUX Fin<20>, aux_50 : AUX Fin<2>, aux_51 : AUX Fin<2>, aux_52 : AUX Fin<1000>, aux_53 : AUX Fin<20>, aux_54 : AUX Arr<20, Fin<20>>, aux_55 : AUX Arr<20, Fin<1000>>, aux_56 : AUX Arr<20, Fin<1000>>, aux_57 : AUX Arr<20, Fin<2>>, aux_58 : AUX Arr<20, Fin<2>>, aux_59 : AUX Arr<20, Arr<20, Fin<2>>>, aux_60 : AUX Arr<20, Fin<1000>>, aux_61 : AUX Arr<20, Fin<2>>, aux_62 : AUX Arr<20, Fin<2>>, aux_63 : AUX Arr<20, Arr<20, Fin<2>>>, aux_64 : AUX Arr<20, Fin<1000>>, aux_65 : AUX Fin<2>, aux_66 : AUX Fin<2>, aux_67 : AUX Arr<20, Fin<2>>, x_3_1 : AUX Arr<20, Fin<2>>, aux_68 : AUX Fin<1000>, aux_69 : AUX Fin<20>, aux_70 : AUX Fin<2>, aux_71 : AUX Fin<2>, aux_72 : AUX Fin<1000>, aux_73 : AUX Fin<20>, aux_74 : AUX Arr<20, Fin<20>>, aux_75 : AUX Arr<20, Fin<1000>>, aux_76 : AUX Arr<20, Fin<1000>>, aux_77 : AUX Arr<20, Fin<2>>, aux_78 : AUX Arr<20, Fin<2>>, aux_79 : AUX Arr<20, Arr<20, Fin<2>>>, aux_80 : AUX Arr<20, Fin<1000>>, aux_81 : AUX Arr<20, Fin<2>>, aux_82 : AUX Arr<20, Fin<2>>, aux_83 : AUX Arr<20, Arr<20, Fin<2>>>, aux_84 : AUX Arr<20, Fin<1000>>, aux_85 : AUX Fin<2>, aux_86 : AUX Fin<2>, aux_87 : AUX Arr<20, Fin<2>>) {
  x_0_1 *= Distr[uniform : Arr<20, Fin<2>>];
  x_0_1, x_0_1_1 *= COPY;
  x_0, x_0_1 *= SWAP;
  call hillclimb_iter_U(x_0, x_1_1, aux_28, aux_29, aux_30, aux_31, aux_32, aux_33, aux_34, aux_35, aux_36, aux_37, aux_38, aux_39, aux_40, aux_41, aux_42, aux_43, aux_44, aux_45, aux_46, aux_47);
  x_1, x_1_1 *= SWAP;
  call hillclimb_iter_U(x_1, x_2_1, aux_48, aux_49, aux_50, aux_51, aux_52, aux_53, aux_54, aux_55, aux_56, aux_57, aux_58, aux_59, aux_60, aux_61, aux_62, aux_63, aux_64, aux_65, aux_66, aux_67);
  x_2, x_2_1 *= SWAP;
  call hillclimb_iter_U(x_2, x_3_1, aux_68, aux_69, aux_70, aux_71, aux_72, aux_73, aux_74, aux_75, aux_76, aux_77, aux_78, aux_79, aux_80, aux_81, aux_82, aux_83, aux_84, aux_85, aux_86, aux_87);
  x_3, x_3_1 *= SWAP;
}

proc hillclimb_3(x_3 : Arr<20, Fin<2>>) { locals : (x_0 : Arr<20, Fin<2>>, x_1 : Arr<20, Fin<2>>, x_2 : Arr<20, Fin<2>>) } {
  x_0 :=$ uniform : Arr<20, Fin<2>>;
  call hillclimb_iter(x_0, x_1);
  call hillclimb_iter(x_1, x_2);
  call hillclimb_iter(x_2, x_3);
}


