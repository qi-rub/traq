proc QSimon(ret_2 : Fin<2>, ret_3 : BitVec<20>) { locals : (QSimon__u : Arr<32, Fin<2>>, QSimon__u_1 : Arr<32, BitVec<20>>) } {
  for (#i_1 in 0 .. < 32) {
    meas SimonOneRound_U_1(QSimon__u[#i_1], QSimon__u_1[#i_1]);
  }
  // simon's post-processing: solve linear system: (ret_2, ret_3) . (QSimon__u, QSimon__u_1) = 0
  call "SolveLinearSystem"(ret_2, ret_3, QSimon__u, QSimon__u_1);
}

