uproc AddWeight_U(acc : IN Fin<1000>, i : IN Fin<10>, acc : OUT Fin<1000>, one : AUX Fin<1000>, one_1 : AUX Fin<1000>, acc_1 : AUX Fin<1000>) {
  one_1 *= Embed[() => const 1:Fin<1000>];
  one, one_1 *= SWAP;
  acc, one, acc_1 *= Embed[(acc, one) => (acc + one)];
  acc, acc_1 *= SWAP;
}

proc AddWeight(acc : Fin<1000>, i : Fin<10>, acc : Fin<1000>) { locals : (one : Fin<1000>) } {
  one := const 1:Fin<1000>;
  acc := (acc + one);
}

uproc main_U(tw : OUT Fin<1000>, acc : AUX Fin<1000>, acc_2 : AUX Fin<1000>, tw_1 : AUX Fin<1000>, aux : AUX Arr<10, Fin<1000>>, aux_1 : AUX Arr<10, Fin<1000>>, aux_2 : AUX Arr<10, Fin<1000>>, aux_3 : AUX Arr<10, Fin<10>>, aux_4 : AUX Arr<11, Fin<1000>>) {
  acc_2 *= Embed[() => const 0:Fin<1000>];
  acc, acc_2 *= SWAP;
  acc, aux_4[0] *= COPY;
  for (#ITER in 0 .. < 10) {
    call AddWeight_U(aux_4[#ITER], aux_3[#ITER], aux_4[#ITER], aux[#ITER], aux_1[#ITER], aux_2[#ITER]);
  }
  aux_4[10], tw_1 *= COPY;
  tw, tw_1 *= SWAP;
}

proc main(tw : Fin<1000>) { locals : (acc : Fin<1000>, iter : Fin<10>) } {
  acc := const 0:Fin<1000>;
  tw := acc;
  for (#ITER_1 in 0 .. < 10) {
    iter := #ITER_1;
    call AddWeight(tw, iter, tw);
  }
}


// qubits: 490
