uproc main_U(acc : OUT Fin<1000>, one : AUX Fin<1000>, i : AUX Fin<10>, acc_1 : AUX Fin<1000>, one_1 : AUX Fin<1000>, acc_2 : AUX Fin<1000>, i_1 : AUX Fin<10>, acc_3 : AUX Fin<1000>, i_2 : AUX Fin<10>, acc_4 : AUX Fin<1000>, i_3 : AUX Fin<10>, acc_5 : AUX Fin<1000>, i_4 : AUX Fin<10>, acc_6 : AUX Fin<1000>, i_5 : AUX Fin<10>, acc_7 : AUX Fin<1000>, i_6 : AUX Fin<10>, acc_8 : AUX Fin<1000>, i_7 : AUX Fin<10>, acc_9 : AUX Fin<1000>, i_8 : AUX Fin<10>, acc_10 : AUX Fin<1000>, i_9 : AUX Fin<10>, acc_11 : AUX Fin<1000>) {
