ext uproc Adj_U(Fin<10>, Fin<10>, Fin<2>);

ext proc Adj(Fin<10>, Fin<10>, Fin<2>);

uproc CompletesTriangle_U(i : IN Fin<10>, j : IN Fin<10>, k : IN Fin<10>, result : OUT Fin<2>, eq_ij : AUX Fin<2>, neq_ij : AUX Fin<2>, eq_jk : AUX Fin<2>, neq_jk : AUX Fin<2>, eq_ki : AUX Fin<2>, neq_ki : AUX Fin<2>, distinct2 : AUX Fin<2>, distinct3 : AUX Fin<2>, edge_jk : AUX Fin<2>, edge_ki : AUX Fin<2>, temp : AUX Fin<2>, eq_ij_1 : AUX Fin<2>, neq_ij_1 : AUX Fin<2>, eq_jk_1 : AUX Fin<2>, neq_jk_1 : AUX Fin<2>, eq_ki_1 : AUX Fin<2>, neq_ki_1 : AUX Fin<2>, distinct2_1 : AUX Fin<2>, distinct3_1 : AUX Fin<2>, edge_jk_1 : AUX Fin<2>, edge_ki_1 : AUX Fin<2>, temp_1 : AUX Fin<2>, result_1 : AUX Fin<2>) {
  i, j, eq_ij_1 *= Embed[(i, j) => (i == j)];
  eq_ij, eq_ij_1 *= SWAP;
  eq_ij, neq_ij_1 *= Embed[(eq_ij) => not eq_ij];
  neq_ij, neq_ij_1 *= SWAP;
  j, k, eq_jk_1 *= Embed[(j, k) => (j == k)];
  eq_jk, eq_jk_1 *= SWAP;
  eq_jk, neq_jk_1 *= Embed[(eq_jk) => not eq_jk];
  neq_jk, neq_jk_1 *= SWAP;
  i, k, eq_ki_1 *= Embed[(i, k) => (k == i)];
  eq_ki, eq_ki_1 *= SWAP;
  eq_ki, neq_ki_1 *= Embed[(eq_ki) => not eq_ki];
  neq_ki, neq_ki_1 *= SWAP;
  neq_ij, neq_jk, distinct2_1 *= Embed[(neq_ij, neq_jk) => (neq_ij && neq_jk)];
  distinct2, distinct2_1 *= SWAP;
  distinct2, neq_ki, distinct3_1 *= Embed[(distinct2, neq_ki) => (distinct2 && neq_ki)];
  distinct3, distinct3_1 *= SWAP;
  call Adj_U(j, k, edge_jk_1);
  edge_jk, edge_jk_1 *= SWAP;
  call Adj_U(k, i, edge_ki_1);
  edge_ki, edge_ki_1 *= SWAP;
  distinct3, edge_jk, temp_1 *= Embed[(distinct3, edge_jk) => (distinct3 && edge_jk)];
  temp, temp_1 *= SWAP;
  edge_ki, temp, result_1 *= Embed[(edge_ki, temp) => (temp && edge_ki)];
  result, result_1 *= SWAP;
}

proc CompletesTriangle(i : Fin<10>, j : Fin<10>, k : Fin<10>, result : Fin<2>) { locals : (eq_ij : Fin<2>, neq_ij : Fin<2>, eq_jk : Fin<2>, neq_jk : Fin<2>, eq_ki : Fin<2>, neq_ki : Fin<2>, distinct2 : Fin<2>, distinct3 : Fin<2>, edge_jk : Fin<2>, edge_ki : Fin<2>, temp : Fin<2>) } {
  eq_ij := (i == j);
  neq_ij := not eq_ij;
  eq_jk := (j == k);
  neq_jk := not eq_jk;
  eq_ki := (k == i);
  neq_ki := not eq_ki;
  distinct2 := (neq_ij && neq_jk);
  distinct3 := (distinct2 && neq_ki);
  call Adj(j, k, edge_jk);
  call Adj(k, i, edge_ki);
  temp := (distinct3 && edge_jk);
  result := (temp && edge_ki);
}

