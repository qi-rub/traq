  ret_1 *= H;
  ret_1 *= X;
}

proc QAny(i : Fin<10>, j : Fin<10>, ret_1 : Fin<2>) { locals : (s_result_1 : Fin<10>, not_done : Fin<2>, Q_sum : Fin<30>, j_2 : Fin<30>, j_lim : Fin<30>) } {
  repeat (28) {
    Q_sum := const 0:Fin<30>;
    for (j_lim in [const 1:Fin<30>, const 1:Fin<30>, const 1:Fin<30>, const 2:Fin<30>, const 2:Fin<30>, const 2:Fin<30>, const 3:Fin<30>, const 3:Fin<30>, const 3:Fin<30>, const 3:Fin<30>, const 3:Fin<30>, const 3:Fin<30>, const 3:Fin<30>]) {
      j_2 :=$ [1 .. j_lim];
      Q_sum := (Q_sum + j_2);
      not_done := (not_done && (Q_sum <= j_lim));
      if (not_done) {
        meas Grover[j_2](i, j, s_result_1, ret_1);
        meas CompletesTriangle_U(i, j, s_result_1, ret_1);
        not_done := (not_done && ret_1);
      } else {
        skip;
      }
    }
  }
}

proc HasTriangleCycle(ij : Tup<Fin<10>, Fin<10>>, result : Fin<2>) { locals : (i : Fin<10>, j : Fin<10>, edge_ij : Fin<2>, found_k : Fin<2>) } {
  i := ij.0;
  j := ij.1;
  call Adj(i, j, edge_ij);
  call QAny(i, j, found_k);
  result := (edge_ij && found_k);
}

