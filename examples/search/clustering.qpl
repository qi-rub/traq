proc main(i : Fin<10>, j : Fin<10>) { locals : (iter : Fin<4>, iter : Fin<4>) } {
  i :=$ uniform : Fin<10>;
  j :=$ uniform : Fin<10>;
  for (#ITER in 0 .. < 4) {
