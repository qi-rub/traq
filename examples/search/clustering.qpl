ext uproc D_n_U(Fin<10>, Arr<10, Fin<100>>);

ext proc D_n(Fin<10>, Arr<10, Fin<100>>);

ext uproc Dist_U(Arr<10, Fin<100>>, Arr<10, Fin<100>>, Fin<100>);

ext proc Dist(Arr<10, Fin<100>>, Arr<10, Fin<100>>, Fin<100>);

uproc check_U(dmax : IN Fin<100>, ij : IN Tup<Fin<10>, Fin<10>>, ok : OUT Fin<2>, i : AUX Fin<10>, j : AUX Fin<10>, xi : AUX Arr<10, Fin<100>>, xj : AUX Arr<10, Fin<100>>, dist' : AUX Fin<100>, i_1 : AUX Fin<10>, j_1 : AUX Fin<10>, xi_1 : AUX Arr<10, Fin<100>>, xj_1 : AUX Arr<10, Fin<100>>, dist'_1 : AUX Fin<100>, ok_1 : AUX Fin<2>) {
  ij, i_1 *= Embed[(ij) => ij.0];
  i, i_1 *= SWAP;
  ij, j_1 *= Embed[(ij) => ij.1];
  j, j_1 *= SWAP;
  call D_n_U(i, xi_1);
  xi, xi_1 *= SWAP;
  call D_n_U(j, xj_1);
  xj, xj_1 *= SWAP;
  call Dist_U(xi, xj, dist'_1);
  dist', dist'_1 *= SWAP;
  dist', dmax, ok_1 *= Embed[(dist', dmax) => (dmax < dist')];
  ok, ok_1 *= SWAP;
}

proc check(dmax : Fin<100>, ij : Tup<Fin<10>, Fin<10>>, ok : Fin<2>) { locals : (i : Fin<10>, j : Fin<10>, xi : Arr<10, Fin<100>>, xj : Arr<10, Fin<100>>, dist' : Fin<100>) } {
  i := ij.0;
  j := ij.1;
  call D_n(i, xi);
  call D_n(j, xj);
  call Dist(xi, xj, dist');
  ok := (dmax < dist');
}

uproc USearch(dmax : Fin<100>, ret : OUT Fin<2>, ret_1 : OUT Tup<Fin<10>, Fin<10>>, aux : AUX Fin<10>, aux_1 : AUX Fin<10>, aux_2 : AUX Arr<10, Fin<100>>, aux_3 : AUX Arr<10, Fin<100>>, aux_4 : AUX Fin<100>, aux_5 : AUX Fin<10>, aux_6 : AUX Fin<10>, aux_7 : AUX Arr<10, Fin<100>>, aux_8 : AUX Arr<10, Fin<100>>, aux_9 : AUX Fin<100>, aux_10 : AUX Fin<2>, aux_11 : AUX Fin<2>, ctrl : AUX Arr<17, Fin<2>>, pred_out : AUX Arr<17, Fin<2>>, n_iter : AUX Arr<17, Fin<8>>, s_arg : AUX Arr<17, Tup<Fin<10>, Fin<10>>>) {
  for (#run_ix in 0 .. < 17) {
    n_iter[#run_ix] *= Unif;
    pred_out[#run_ix] *= X;
    pred_out[#run_ix] *= H;
    s_arg[#run_ix] *= Unif;
    for (#LIM in 0 .. < 8) {
      n_iter[#run_ix], ctrl[#run_ix] *= Embed[(a) => (a <= #LIM)];
      call check_U(dmax, s_arg[#run_ix], aux_11, aux, aux_1, aux_2, aux_3, aux_4, aux_5, aux_6, aux_7, aux_8, aux_9, aux_10);
      ctrl[#run_ix], aux_11, pred_out[#run_ix] *= Toffoli;
      call-adj check_U(dmax, s_arg[#run_ix], aux_11, aux, aux_1, aux_2, aux_3, aux_4, aux_5, aux_6, aux_7, aux_8, aux_9, aux_10);
      s_arg[#run_ix] *= Adj-Unif;
      s_arg[#run_ix] *= PhaseOnZero(3.141592653589793);
      s_arg[#run_ix] *= Unif;
      n_iter[#run_ix], ctrl[#run_ix] *= Embed[(a) => (a <= #LIM)];
    }
    pred_out[#run_ix] *= H;
    pred_out[#run_ix] *= X;
    n_iter[#run_ix] *= Unif;
    ctrl[#run_ix] *= X;
    call check_U(dmax, s_arg[#run_ix], aux_11, aux, aux_1, aux_2, aux_3, aux_4, aux_5, aux_6, aux_7, aux_8, aux_9, aux_10);
    ctrl[#run_ix], aux_11, pred_out[#run_ix] *= Toffoli;
    call-adj check_U(dmax, s_arg[#run_ix], aux_11, aux, aux_1, aux_2, aux_3, aux_4, aux_5, aux_6, aux_7, aux_8, aux_9, aux_10);
    ctrl[#run_ix] *= X;
  }
  pred_out, ret *= NamedGate("any");
  s_arg, pred_out, ret_1 *= Embed[(a, f) => (a selectOn f)];
}

uproc loop_body_U(i : IN Fin<10>, j : IN Fin<10>, i' : OUT Fin<10>, j' : OUT Fin<10>, xi : AUX Arr<10, Fin<100>>, xj : AUX Arr<10, Fin<100>>, dmax : AUX Fin<100>, ok : AUX Fin<2>, ij' : AUX Tup<Fin<10>, Fin<10>>, xi_2 : AUX Arr<10, Fin<100>>, xj_2 : AUX Arr<10, Fin<100>>, dmax_1 : AUX Fin<100>, ok_2 : AUX Fin<2>, ij'_1 : AUX Tup<Fin<10>, Fin<10>>, aux : AUX Fin<10>, aux_1 : AUX Fin<10>, aux_2 : AUX Arr<10, Fin<100>>, aux_3 : AUX Arr<10, Fin<100>>, aux_4 : AUX Fin<100>, aux_5 : AUX Fin<10>, aux_6 : AUX Fin<10>, aux_7 : AUX Arr<10, Fin<100>>, aux_8 : AUX Arr<10, Fin<100>>, aux_9 : AUX Fin<100>, aux_10 : AUX Fin<2>, aux_11 : AUX Fin<2>, ctrl : AUX Arr<17, Fin<2>>, pred_out : AUX Arr<17, Fin<2>>, n_iter : AUX Arr<17, Fin<8>>, s_arg : AUX Arr<17, Tup<Fin<10>, Fin<10>>>, aux_prim : AUX Fin<10>, aux_prim_1 : AUX Fin<10>, aux_prim_2 : AUX Arr<10, Fin<100>>, aux_prim_3 : AUX Arr<10, Fin<100>>, aux_prim_4 : AUX Fin<100>, aux_prim_5 : AUX Fin<10>, aux_prim_6 : AUX Fin<10>, aux_prim_7 : AUX Arr<10, Fin<100>>, aux_prim_8 : AUX Arr<10, Fin<100>>, aux_prim_9 : AUX Fin<100>, aux_prim_10 : AUX Fin<2>, aux_prim_11 : AUX Fin<2>, aux_prim_12 : AUX Arr<17, Fin<2>>, aux_prim_13 : AUX Arr<17, Fin<2>>, aux_prim_14 : AUX Arr<17, Fin<8>>, aux_prim_15 : AUX Arr<17, Tup<Fin<10>, Fin<10>>>, i'_1 : AUX Fin<10>, j'_1 : AUX Fin<10>) {
  call D_n_U(i, xi_2);
  xi, xi_2 *= SWAP;
  call D_n_U(j, xj_2);
  xj, xj_2 *= SWAP;
  call Dist_U(xi, xj, dmax_1);
  dmax, dmax_1 *= SWAP;
  call USearch(dmax, ok_2, ij'_1, aux_prim, aux_prim_1, aux_prim_2, aux_prim_3, aux_prim_4, aux_prim_5, aux_prim_6, aux_prim_7, aux_prim_8, aux_prim_9, aux_prim_10, aux_prim_11, aux_prim_12, aux_prim_13, aux_prim_14, aux_prim_15);
  ok, ij', ok_2, ij'_1 *= SWAP;
  ij', i'_1 *= Embed[(ij') => ij'.0];
  i', i'_1 *= SWAP;
  ij', j'_1 *= Embed[(ij') => ij'.1];
  j', j'_1 *= SWAP;
}

uproc Grover[k](dmax : Fin<100>, x : IN Tup<Fin<10>, Fin<10>>, ret_2 : OUT Fin<2>, aux_12 : AUX Fin<10>, aux_13 : AUX Fin<10>, aux_14 : AUX Arr<10, Fin<100>>, aux_15 : AUX Arr<10, Fin<100>>, aux_16 : AUX Fin<100>, aux_17 : AUX Fin<10>, aux_18 : AUX Fin<10>, aux_19 : AUX Arr<10, Fin<100>>, aux_20 : AUX Arr<10, Fin<100>>, aux_21 : AUX Fin<100>, aux_22 : AUX Fin<2>) {
  ret_2 *= X;
  ret_2 *= H;
  x *= Unif;
  repeat (#k) {
    call check_U(dmax, x, ret_2, aux_12, aux_13, aux_14, aux_15, aux_16, aux_17, aux_18, aux_19, aux_20, aux_21, aux_22);
    x *= Adj-Unif;
    x *= PhaseOnZero(3.141592653589793);
    x *= Unif;
  }
  ret_2 *= H;
  ret_2 *= X;
}

proc QSearch(dmax : Fin<100>, ret_2 : Fin<2>, ret_3 : Tup<Fin<10>, Fin<10>>) { locals : (not_done : Fin<2>, Q_sum : Fin<92>, j_2 : Fin<92>, j_lim : Fin<92>) } {
  repeat (8) {
    Q_sum := const 0:Fin<92>;
    for (j_lim in [const 1:Fin<92>, const 1:Fin<92>, const 1:Fin<92>, const 2:Fin<92>, const 2:Fin<92>, const 2:Fin<92>, const 3:Fin<92>, const 4:Fin<92>, const 5:Fin<92>, const 6:Fin<92>, const 7:Fin<92>, const 8:Fin<92>, const 10:Fin<92>, const 10:Fin<92>, const 10:Fin<92>, const 10:Fin<92>, const 10:Fin<92>]) {
      j_2 :=$ [1 .. j_lim];
      Q_sum := (Q_sum + j_2);
      not_done := (not_done && (Q_sum <= j_lim));
      if (not_done) {
        meas Grover[j_2](dmax, ret_3, ret_2);
        meas check_U(dmax, ret_3, ret_2);
        not_done := (not_done && ret_2);
      } else {
        skip;
      }
    }
  }
}

proc loop_body(i : Fin<10>, j : Fin<10>, i' : Fin<10>, j' : Fin<10>) { locals : (xi : Arr<10, Fin<100>>, xj : Arr<10, Fin<100>>, dmax : Fin<100>, ok : Fin<2>, ij' : Tup<Fin<10>, Fin<10>>) } {
  call D_n(i, xi);
  call D_n(j, xj);
  call Dist(xi, xj, dmax);
  call QSearch(dmax, ok, ij');
  i' := ij'.0;
  j' := ij'.1;
}

